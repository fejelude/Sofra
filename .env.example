# Required
DISCORD_TOKEN=

# Optional: register all Sofra slash commands immediately in one server
DISCORD_GUILD_ID=

# Optional public website origin, used by /help and /setup (HTTPS only).
SOFRA_WEBSITE_URL=https://fejelude.xyz

# Optional: personal name-trigger easter egg is OFF unless scoped to one guild.
# Leave empty for a general-purpose public deployment.
SOFRA_PERSONAL_GUILD_ID=

# Optional: defaults to ./data/welcome-config.json
WELCOME_CONFIG_PATH=

# Optional: defaults to ./data/levels.sqlite (Node.js 24 built-in SQLite)
LEVEL_DATABASE_PATH=

# Required for Sofra Panel synchronization.
# Use the same Upstash Redis REST database configured on the Vercel website.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: dashboard-to-bot refresh interval in milliseconds (2000-60000).
# Default: 4000
SOFRA_CONFIG_POLL_MS=4000

# Required to enable AI chat. Create this secret in Google AI Studio; never commit it.
GEMINI_API_KEY=

# Optional: defaults to Gemini 3.6 Flash.
GEMINI_MODEL=gemini-3.6-flash
